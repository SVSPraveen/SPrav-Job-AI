# ──────────────────────────────────────────────────────────────
# SPrav MoE Pipeline — Environment Variables
# Copy this to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# JWT auth secret (set this to a long random string)
JWT_SECRET=change_me_to_a_long_random_string

# (Optional) Cloud LLM fallback keys — only needed if mode.yaml is not 'local'
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# (Optional) SMTP Email Notifications
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_RECEIVER=your_email@gmail.com

# ──────────────────────────────────────────────────────────────
# Guided Submission Gating Thresholds
# ──────────────────────────────────────────────────────────────

# Minimum ATS keyword coverage required to mark an application
# as ready for guided review (0.0–1.0)
ATS_AUTO_APPLY_THRESHOLD=0.88

# Minimum fit score required to mark an application
# as ready for guided review (1.0–5.0)
FIT_AUTO_APPLY_THRESHOLD=4.0

# Maximum guided submissions to a single company per calendar day.
COMPANY_DAILY_CAP=1

# Maximum guided submissions to a single portal per calendar day.
PORTAL_DAILY_CAP=10

# Legacy internal variable name:
# maximum human-approved guided submissions across all portals per calendar day.
TOTAL_DAILY_CAP=20

# Legacy internal variable name:
# Number of consecutive Playwright submission failures before the guided submission loop
# is paused and a dashboard alert is raised. Counter is persisted to DB.
AUTO_APPLY_CIRCUIT_BREAKER_N=3
